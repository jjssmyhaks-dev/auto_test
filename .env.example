# API
PORT=8787
# Optional Postgres (docker-compose). If unset, the API uses ~/.veriflow/cloud-data JSON.
DATABASE_URL=postgres://veriflow:veriflow@127.0.0.1:5432/veriflow

# Optional S3-compatible blobs (MinIO). If unset, files go under VERIFLOW_BLOBS_DIR.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=veriflow
S3_ACCESS_KEY=veriflow
S3_SECRET_KEY=veriflowsecret
S3_REGION=us-east-1

VERIFLOW_BLOBS_DIR=.veriflow-data/blobs
VERIFLOW_CLOUD_DIR=.veriflow-data
# VERIFLOW_ALERT_WEBHOOK=http://127.0.0.1:9999/hooks/veriflow
# STRIPE_SECRET_KEY=

# Dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# MCP / CLI
VERIFLOW_API_URL=http://127.0.0.1:8787
# VERIFLOW_API_KEY=vf_...
