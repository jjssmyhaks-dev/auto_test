{
  "name": "veriflow",
  "private": true,
  "version": "0.1.0",
  "description": "Veriflow — local-first vision browser testing platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "pnpm --filter @veriflow/cli start",
    "playwright:install": "pnpm --filter @veriflow/harness exec playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
